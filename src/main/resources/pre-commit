#!/bin/sh
# Multi-hook dispatcher
set -e

HOOK_DIR="$(dirname "$0")/pre-commit.d"

if [ -d "$HOOK_DIR" ]; then
  # Run all executable files in alphabetical order
  for hook in "$HOOK_DIR"/*; do
    # Skip directories and verify that the hook file exists and is executable
    if [ -f "$hook" ] && [ -x "$hook" ]; then
      echo "Executing Git hook: $(basename "$hook")"
      "$hook" "$@"
    fi
  done
fi

exit 0
